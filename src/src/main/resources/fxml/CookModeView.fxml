<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="app.cookyourbooks.gui.view.CookModeViewController"
            styleClass="cook-mode-root">

    <top>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="cook-mode-topbar">
            <padding>
                <Insets top="8" right="8" bottom="8" left="8"/>
            </padding>
            <Label fx:id="recipeTitleLabel"
                   id="cook-mode-title"
                   text="Cooking..."
                   styleClass="cook-mode-title"/>
        </HBox>
    </top>

    <center>
        <HBox spacing="12" styleClass="cook-mode-content">
            <padding>
                <Insets top="8" right="8" bottom="8" left="8"/>
            </padding>

            <VBox spacing="12" HBox.hgrow="ALWAYS" styleClass="cook-mode-left-column">
                <Label fx:id="stepLabel"
                       id="cook-mode-step-label"
                       text="Step 1"
                       styleClass="cook-mode-step-heading"/>

                <Label text="Instructions" styleClass="cook-mode-subheading"/>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="cook-mode-instruction-scroll">
                    <content>
                        <Label fx:id="instructionTextLabel"
                               id="cook-mode-instruction-text"
                               wrapText="true"
                               styleClass="cook-mode-instruction-text"/>
                    </content>
                </ScrollPane>

                <Label text="Notes" styleClass="cook-mode-subheading"/>
                <TextArea fx:id="notesTextArea"
                          id="cook-mode-notes"
                          promptText="Add your notes here..."
                          wrapText="true"
                          prefRowCount="4"
                          styleClass="cook-mode-notes"/>
            </VBox>

            <VBox spacing="8" styleClass="cook-mode-ingredients-pane" prefWidth="280" minWidth="280" maxWidth="280">
                <Label text="Ingredients" styleClass="cook-mode-subheading"/>
                <ListView fx:id="ingredientsListView"
                          id="cook-mode-ingredients-list"
                          VBox.vgrow="ALWAYS"/>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <HBox spacing="8" alignment="CENTER_LEFT" styleClass="cook-mode-bottom-bar">
            <padding>
                <Insets top="8" right="8" bottom="8" left="8"/>
            </padding>
            <Button fx:id="previousStepButton"
                    id="cook-mode-previous-button"
                    text="Previous Step"/>
            <Button fx:id="nextStepButton"
                    id="cook-mode-next-button"
                    text="Next Step"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="exitCookModeButton"
                    id="cook-mode-exit-button"
                    text="Exit Cook Mode"/>
        </HBox>
    </bottom>

</BorderPane>
